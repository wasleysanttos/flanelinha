<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.wasleysantos.flanelinha.fragment.NovaVagaFragment">


    <ProgressBar
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:id="@+id/registre_nova_vaga"
        android:layout_gravity="center" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_gravity="center_vertical|bottom"
        android:background="@color/colorCheckin"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_Check_In_New"
            android:layout_width="100sp"
            android:layout_height="wrap_content"
            android:src="@drawable/estacionar" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentTop="true"
            android:spinnerMode="dialog"
            android:layout_toRightOf="@+id/action_Check_In_New"
            android:layout_toEndOf="@+id/action_Check_In_New" />


    </RelativeLayout>


</FrameLayout>


